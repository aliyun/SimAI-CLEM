+#include <map>
+#include <string>
+#include <iostream>
+#include <fstream>
+#include <sstream>
+#include <cstdlib>
+
+extern std::map<int, std::map<std::string, std::string>> simhca2realhca_map;
+
+inline const char* get_hca_map_filename() {
+  const char* env_filename = std::getenv("SIMHCA2REALHCA_MAP_FILENAME");
+  if (env_filename != nullptr) {
+    return env_filename;
+  }
+  // 默认路径
+  return NULL;
+}
+
+void load_hca_map() {
+  const char* filename = get_hca_map_filename();
+  if (filename == NULL) {
+    fprintf(stderr, "Error: SIMHCA2REALHCA_MAP_FILENAME not set\n");
+    return;
+  }
+  std::ifstream file(filename);
+  if (!file.is_open()) {
+    fprintf(stderr, "Error: cannot open %s\n", filename);
+    return;
+  }
+  std::string line;
+  while (std::getline(file, line)) {
+    // 忽略空行和注释行
+    if (line.empty()) continue;
+    if (line[0] == '#') continue;
+    
+    std::istringstream iss(line);
+    int node_id;
+    std::string sim_hca;
+    std::string real_hca;
+    if(!(iss >> node_id >> sim_hca >> real_hca)) {
+      fprintf(stderr, "Error: invalid line: %s\n", line.c_str());
+      return;
+    }
+    simhca2realhca_map[node_id][sim_hca] = real_hca;
+  }
+  file.close();
+  return; 
+}
