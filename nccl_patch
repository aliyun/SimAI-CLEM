+uint32_t cal_sge_total_len(struct ibv_sge *sg_list, 
+											int num_sge)
+{
+  uint32_t total_len = 0;
+  for(int i=0;i<num_sge;i++) {
+    total_len += sg_list[i].length;
+  }
+  return total_len;
+}
